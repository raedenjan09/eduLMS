# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lms?retryWrites=true&w=majority

# Security (strong secret key)
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (for CORS allowance, no trailing slash; comma-separated if multiple)
CLIENT_URL=https://your-frontend.vercel.app

# Cloudinary (media & PDF storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

